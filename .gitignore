# ── Firebase ──────────────────────────────────────────────────────────────────
# Android Firebase config (contains API key + project info)
google-services.json

# iOS Firebase config (contains API key + project info)
GoogleService-Info.plist

# Dart Firebase options — committed so CI can build without extra setup
# lib/firebase_options.dart

# Firebase service account / admin SDK keys
serviceAccountKey.json
*-firebase-adminsdk-*.json
firebase-credentials.json
firebase_credentials.json

